# HMX Property Valuation & HMX Home Studio — Environment Configuration

# 1. Frontend Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 2. Backend Environment & Security (Phase 9–11 — Never expose in NEXT_PUBLIC_*)
# Set HMX_ENV=production in production deployments
HMX_ENV=development

# Cryptographic secret (minimum 32 random bytes) used to sign HttpOnly session cookies
HMX_AUTH_SECRET=replace-with-32-byte-hex-secret-in-production

# Session lifetime in seconds (default: 604800 = 7 days)
HMX_SESSION_TTL_SECONDS=604800

# Comma-separated allowed CORS origins for credentialed requests
HMX_CORS_ORIGINS=http://localhost:3000,https://hmx-jtyj-gse8d18e2-syndicate10.vercel.app

# 3. Production PostgreSQL Database Configuration (Mandatory when HMX_ENV=production)
# Example: postgresql+psycopg2://db_user:db_password@db_host:5432/hmx_home_studio?sslmode=require
DATABASE_URL=

# SQLAlchemy Connection Pool Settings (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
